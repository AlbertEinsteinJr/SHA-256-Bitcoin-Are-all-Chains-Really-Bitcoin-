# Copy to .env.local and fill in. Consumed via app.config.ts -> expo-constants.
APP_ENV=development
API_BASE_URL=https://api.example.com

# Google Maps (react-native-maps) — separate key per platform, restricted by bundle id / SHA-1.
IOS_GOOGLE_MAPS_KEY=
ANDROID_GOOGLE_MAPS_KEY=

# Sentry (crash + performance). DSN is safe to ship; auth token is build-time only.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Firebase config files are injected as native resources at build time, not here:
#   ios/GoogleService-Info.plist   android/app/google-services.json
