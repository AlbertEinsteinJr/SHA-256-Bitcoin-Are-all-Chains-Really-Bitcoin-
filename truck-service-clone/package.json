{
  "name": "roadside-directory",
  "version": "7.0.6",
  "private": true,
  "description": "Clean-room structural clone of a heavy-duty truck-service / roadside-directory mobile build (Expo React Native). Unbranded reference scaffold for architectural dissection — not affiliated with any shipping app.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
