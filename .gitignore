__pycache__/
*.pyc
.coverage
.pytest_cache/

# Build artifacts from `pip install -e .`
*.egg-info/
build/
dist/

# PROMETHEUS runtime state (archive DB, audit/trace logs, worktrees, kill flag)
.prometheus/

# Engine-generated lineage snapshots (the archive/ directory keeps its README,
