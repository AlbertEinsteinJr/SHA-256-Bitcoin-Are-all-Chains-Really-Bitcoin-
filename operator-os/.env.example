# Operator OS environment. Copy to .env.local and fill. NEVER commit real values.
# Constitution §6: staging and prod use SEPARATE credentials with least privilege.

# --- Supabase (public, browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
# The self-improvement LOOP must NOT hold this key. It is for migrations/admin only,
# and is used by the API/worker control plane that lives outside the loop's blast radius.
SUPABASE_SERVICE_ROLE_KEY=
# Least-privilege runtime connection string for the loop worker (role: loop_rw).
LOOP_DATABASE_URL=

# --- Anthropic (LLM: judge, component-under-test, variant generation) ---
ANTHROPIC_API_KEY=

# --- Voyage AI (skill-library embeddings; Anthropic has no embeddings endpoint) ---
VOYAGE_API_KEY=

# --- Safety ---
# Operator timezone for the APPROVED-<ACTION>-<YYYYMMDD> date check (default UTC).
OPERATOR_TZ=UTC
# HMAC key for signing single-use approval tokens (Tier-2: move to an HSM/offline key).
APPROVAL_SIGNING_KEY=

# --- Caps (override the DB defaults if needed) ---
LOOP_MAX_ITERATIONS=20
LOOP_SPEND_CAP_USD=5
LOOP_RATE_PER_MIN=30
